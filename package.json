{
  "name": "devlab",
  "version": "1.0.0",
  "private": true,
  "description": "DevLab — laboratorio interactivo de ejecucion, depuracion y analisis de algoritmos",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase db push",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:apply": "node scripts/apply-migrations.mjs",
    "supabase:bundle": "node scripts/build-migration-bundle.mjs",
    "supabase:verify": "node scripts/verify-supabase.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "monaco-editor": "0.55.1",
    "next": "16.4.2",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "monaco-editor": "0.57.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
