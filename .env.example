# =============================================================================
# DevLab · Variables de entorno (plantilla)
# -----------------------------------------------------------------------------
# Copia este fichero a `.env.local` (no versionado) y rellena los valores.
# =============================================================================

# --- Supabase (obligatorio para autenticación y persistencia) -------------
# URL del proyecto de Supabase. La misma URL se usa en cliente y servidor.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "publishable" (formato nuevo: sb_publishable_...). Antes se
# llamaba "anon". Es pública por diseno: la seguridad la garantizan las
# politicas RLS. NUNCA uses la clave secreta (sb_secret_) en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE

# Clave secreta del servidor (sb_secret_...). SOLO en el runtime del servidor y
# SOLO si una operación concreta la requiere de forma justificada. Si se deja
# vacia, la aplicación sigue funcionando con RLS + la clave publishable.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la aplicación (usada por los flujos OAuth y de recuperación
# de contrasena). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcional: personal access token de Supabase ---------------------------
# Solo para `npm run supabase:apply` (aplicar migraciones por la Management
# API). Se crea en Account -> Access Tokens. No se usa en la aplicación.
SUPABASE_ACCESS_TOKEN=

# --- IA opcional -----------------------------------------------------------
# Proveedor compatible con la API de OpenAI (endpoint /v1/chat/completions).
# Si se dejan vacios, DevLab funciona igual, simplemente sin explicaciones
# por IA.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- Pyodide ---------------------------------------------------------------
# Ruta pública donde se sirve el runtime de Pyodide (copiado por
# `npm install` desde node_modules/pyodide).
NEXT_PUBLIC_PYODIDE_INDEX_URL=/pyodide/
